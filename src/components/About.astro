---
import { getLangFromUrl, useTranslations } from '../i18n/translations';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="section" id="about">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <h2 class="section-title">{t('about.title')}</h2>
    </div>

    <div class="about animate-on-scroll">
      <img src="/portfolio/images/photo.jpg" alt="Tahar Guenfoud" class="about-photo" />
      <p>{t('about.bio')}</p>
      <h3>{t('about.languages')}</h3>
      <div class="skills-list">
        <span class="skill-item">{t('about.languages.fr')}</span>
        <span class="skill-item">{t('about.languages.en')}</span>
        <span class="skill-item">{t('about.languages.ar')}</span>
        <span class="skill-item">{t('about.languages.ru')}</span>
        <span class="skill-item">{t('about.languages.nl')}</span>
      </div>
    </div>
  </div>
</section>
